---
import Layout from "../layouts/Layout.astro";

const teamList = [
  {
    avatar: "/team/puppetsheep.jpg",
    name: "puppetsheep",
    role: "项目发起人",
    description: "UI 设计、文案与技术开发支持",
    github: "https://github.com/puppetsheep",
    website: "https://puppetsheep.github.io",
  },
  {
    avatar: "/team/ihoey.png",
    name: "Ihoey",
    role: "项目负责人",
    description: "技术支持、架构与项目指导",
    github: "https://github.com/ihoey",
    website: "https://blog.ihoey.com",
  },
  {
    avatar: "/team/zhangpeng2k.jpg",
    name: "zhangpeng2k",
    role: "项目开发者",
    description: "技术开发支持 · DreamStacks 成员",
    github: "https://github.com/zhangpeng2k",
    website: "https://zhangpeng2k.github.io",
  },
];
---

<Layout title='团队介绍'>
  <section class='team-page' aria-labelledby='team-title'>
    <header class='team-intro'>
      <h1 id='team-title'>吃货指南背后的伙伴</h1>
      <p>从设计、文案到代码，我们一起把对美食的兴趣，变成一份持续完善的指南。</p>
    </header>

    <ul class='team-list' aria-label='团队成员'>
      {
        teamList.map((member) => (
          <li class='member'>
            <img class='member-avatar' src={member.avatar} alt={`${member.name} 的头像`} width='80' height='80' decoding='async' />
            <div class='member-info'>
              <div class='member-heading'>
                <h2>{member.name}</h2>
                <span class='member-role'>{member.role}</span>
              </div>
              <p>{member.description}</p>
            </div>
            <div class='member-links'>
              <a href={member.github} target='_blank' rel='noopener noreferrer' aria-label={`${member.name} 的 GitHub（新窗口）`}>
                GitHub <span aria-hidden='true'>↗</span>
              </a>
              <a href={member.website} target='_blank' rel='noopener noreferrer' aria-label={`${member.name} 的个人网站（新窗口）`}>
                个人网站 <span aria-hidden='true'>↗</span>
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <aside class='join-team' aria-labelledby='join-title'>
      <div>
        <h2 id='join-title'>也欢迎你，一起参与</h2>
        <p>分享家乡的味道、补充资料，或参与设计和开发。<br />每一份贡献，都会让这份指南更丰富。</p>
      </div>
      <a class='contribute-link' href='https://github.com/DreamStacks/food-geo-mapping' target='_blank' rel='noopener noreferrer'>
        在 GitHub 参与 <span aria-hidden='true'>↗</span>
      </a>
    </aside>
  </section>
</Layout>

<style lang='scss'>
  .team-page {
    width: 100%;
    max-width: 960px;
    margin: clamp(32px, 5vh, 64px) auto;
    padding: clamp(24px, 4vw, 48px);
    border-radius: 16px;
    background: rgb(8 16 24 / 72%);
  }

  .team-intro {
    margin-bottom: 36px;

    h1 {
      margin: 0 0 20px;
      color: var(--color-blue);
      font-size: clamp(1.75rem, 3vw, 2.5rem);
      font-weight: 650;
      line-height: 1.4;
      letter-spacing: 0.04em;
      text-wrap: balance;
    }

    p {
      max-width: 36em;
      margin: 0;
      color: var(--color-muted);
      font-size: 1rem;
      line-height: 1.9;
      text-wrap: pretty;
    }
  }

  .team-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .member {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 24px;
    padding-block: 28px;
    border-top: 1px solid rgb(209 218 224 / 18%);
  }

  .member-avatar {
    display: block;
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 50%;
    background: #202830;
  }

  .member-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;

    h2 {
      margin: 0;
      font-size: 1.375rem;
      font-weight: 650;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }
  }

  .member-role {
    color: var(--color-blue);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .member-info p {
    margin: 8px 0 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .member-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      font-size: 0.875rem;
      color: var(--color-muted);
      white-space: nowrap;

      &:hover {
        color: var(--color-yellow);
        text-decoration: underline;
        text-underline-offset: 5px;
      }
    }
  }

  .join-team {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 32px;
    border-top: 1px solid rgb(209 218 224 / 18%);

    h2 {
      margin: 0 0 12px;
      font-size: 1.25rem;
      font-weight: 550;
    }

    p {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.9375rem;
      line-height: 1.9;
    }
  }

  .contribute-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid var(--color-yellow);
    border-radius: 8px;
    color: var(--color-yellow);
    font-size: 0.875rem;

    &:hover {
      background: rgb(255 240 1 / 8%);
    }
  }

  @media (max-width: 720px) {
    .member {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 12px 20px;
    }

    .member-avatar {
      width: 64px;
      height: 64px;
    }

    .member-links {
      grid-column: 2;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 20px;
    }
  }

  @media (max-width: 420px) {
    .team-page {
      padding: 24px 20px;
    }

    .member {
      grid-template-columns: 48px minmax(0, 1fr);
      column-gap: 16px;
      align-items: start;
    }

    .member-avatar {
      width: 48px;
      height: 48px;
      margin-top: 4px;
    }

    .member-heading h2 {
      font-size: 1.125rem;
    }

    .member-links {
      grid-column: 1 / -1;
      padding-left: 64px;
      column-gap: 16px;
    }
  }
</style>
