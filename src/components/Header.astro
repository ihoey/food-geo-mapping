---
const navs = [
  {
    path: "/",
    name: "首页",
  },
  {
    path: "/team",
    name: "团队介绍",
  },
  {
    path: "/about",
    name: "关于",
  },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class='ds-header container'>
  <a href='/' class='ds-logo'>
    <img src='/logo.png' alt='吃货指南' class='ds-logo-img' width='44' height='44' />
  </a>
  <nav aria-label='主导航'>
    <ul class='ds-navs'>
      {
        navs.map((item) => (
          <li>
            <a href={item.path} aria-current={currentPath === item.path ? 'page' : undefined}>
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style lang='scss'>
  .ds-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: clamp(24px, 4vh, 48px);
    padding-bottom: 16px;
  }

  .ds-logo {
    display: inline-flex;
    flex-shrink: 0;
    border-radius: 10px;

    img {
      display: block;
      width: 44px;
      height: 44px;
    }
  }

  .ds-navs {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;

    a {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 44px;
      color: var(--color-muted);
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      white-space: nowrap;
      transition: color 160ms ease-out;

      &::after {
        content: '';
        position: absolute;
        bottom: 1px;
        left: 50%;
        width: 16px;
        height: 2px;
        border-radius: 1px;
        background: var(--color-yellow);
        transform: translateX(-50%) scaleX(0);
        transition: transform 160ms ease-out;
      }

      &:hover,
      &[aria-current='page'] {
        color: var(--color-text);
      }

      &[aria-current='page']::after {
        transform: translateX(-50%) scaleX(1);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-navs a,
    .ds-navs a::after {
      transition: none;
    }
  }
</style>
